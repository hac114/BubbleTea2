{
  "name": "backend",
  "version": "1.0.0",
  "description": "API Backend per il sistema BubbleTea",
  "main": "app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon --watch ./ --ext js,mjs,json --delay 250ms --exec node app.js",
    "test": "jest --verbose --testTimeout=10000",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "test:Personalizzazione": "jest tests/unit/models/Personalizzazione.test.js",
    "test:orderitem": "jest orderItem.test.js --verbose",
    "test:Ordine": "jest tests/unit/models/Ordine.test.js",
    "test:OrdineDB": "jest tests/unit/models/Ordine.test.db.js --runInBand --verbose",
    "test:Pagamento": "jest tests/unit/models/Pagamento.test.js",
    "test:integration": "npm run test:OrdineDB", 
    "clear-test": "jest --clearCache",
    "test:all": "npm run test:Ordine && npm run test:OrdineDB && npm run test:Pagamento && npm run test:Personalizzazione"
  },
  "keywords": [
    "bubbletea",
    "api",
    "nodejs",
    "mongodb",
    "restapi"
  ],
  "author": {
    "name": "Maurizio Chieruzzi",
    "email": "maurizio.chieruzzi@email.com",
    "url": "https://github.com/maurizio-chieruzzi"
  },
  "license": "ISC",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "mongoose": "^8.16.3",
    "morgan": "^1.10.0",
    "rate-limit-redis": "^3.1.0",
    "stripe": "^18.4.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "detectOpenHandles": true,
    "verbose": true,
    "testMatch": [
      "**/*.test.js",
      "**/*.test.db.js"
    ]
  }
}